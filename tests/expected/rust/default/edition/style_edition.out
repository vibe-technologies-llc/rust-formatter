// style_edition is forwarded to rustfmt as its own flag, not as --edition.
// A wrapping difference against the default style edition is acceptable;
// dropping the imports' three-tier grouping is not.
use std::fmt;

use serde::Serialize;

use crate::{a::First, b::Second};

pub fn f(_: &dyn fmt::Debug, _: First, _: Second) -> impl Serialize {
    0u8
}
