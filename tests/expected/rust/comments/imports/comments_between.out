// A comment between imports takes two rustfmt passes to settle (rustfmt#6195),
// which is why the runner retries. The note has to survive grouping and still
// sit with the std import it was written against.
// a note between imports
use std::fmt;

use crate::{a::First, b::Second};

pub fn f(_: &dyn fmt::Debug, _: First, _: Second) {}
