// Trailing comments on individual use items have to stay attached after
// Crate-level merge. `b` is the one with the note; merging it into
// `crate::{a, b}` must not drop or move that comment onto `a`.
use std::fmt;

use serde::Serialize;

use crate::{a::First, b::Keep}; // stays with b

pub fn f(_: &dyn fmt::Debug, _: First, _: Keep) -> impl Serialize {
    0u8
}
