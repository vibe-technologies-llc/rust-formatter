[package]
    name    = "sortable"
    version = "0.1.0"

[dependencies]

    zzz = "1"
    # a note about mmm, which has to travel with it
    mmm = {version = "2", features = [ "derive" ]}

    # a second block, after a blank line
    bbb           = "3"
    aaa.workspace = true
    "quoted-dep"  = "4"

[dev-dependencies]
    zeta  = "1"
    alpha = "2"

    [dependencies.ggg]
        version = "5"

    # between two header blocks
    [dependencies.ccc]
        version  = "6"
        features = [ "x" ]

[target.'cfg(unix)'.dependencies]
    nix  = "0.2"
    libc = "0.2"

[build-dependencies]
    only-one = "1"

[workspace.dependencies]
    serde  = {version = "1", features = [ "derive" ]}
    anyhow = "1"
