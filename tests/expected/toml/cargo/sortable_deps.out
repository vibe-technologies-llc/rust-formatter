[package]
name = "sortable"
version = "0.1.0"

[dependencies]
aaa.workspace = true
# a second block, after a blank line
bbb = "3"
# a note about mmm, which has to travel with it
mmm = { features = ["derive"], version = "2" }
quoted-dep = "4"
zzz = "1"

# between two header blocks
[dependencies.ccc]
features = ["x"]
version = "6"

[dependencies.ggg]
version = "5"

[dev-dependencies]
alpha = "2"
zeta = "1"

[build-dependencies]
only-one = "1"

[target.'cfg(unix)'.dependencies]
libc = "0.2"
nix = "0.2"

[workspace.dependencies]
anyhow = "1"
serde = { features = ["derive"], version = "1" }
